#!/bin/sh
# zflip3-webcam-ctl — fixed subcommands for LuCI (no arbitrary shell).
set -eu
STREAM=/usr/bin/stream.py
SETUP=/usr/bin/setup-camera.sh
LOG=/tmp/webcam.log

pid() { ps 2>/dev/null | awk '/[s]tream.py/{print $1; exit}'; }

case "${1:-}" in
	status)
		p=$(pid)
		printf 'running=%s\n' "$([ -n "$p" ] && echo 1 || echo 0)"
		printf 'pid=%s\n' "${p:-0}"
		printf 'mode=%s\n' "$(cat /etc/zflip3-cam.mode 2>/dev/null || echo rear)"
		printf 'amp=%s\n' "$(amixer -c 0 sget 'Speaker Amp Gain ZC' 2>/dev/null | grep -o 'Playback \[[a-z]*\]' | head -1 | tr -d '[]' | awk '{print $2}' || echo unknown)"
		printf 'url_usb=http://192.168.44.1:8082/\n'
		printf 'url_ap=http://192.168.45.1:8082/\n'
		;;
	start)
		MODE=${2:-$(cat /etc/zflip3-cam.mode 2>/dev/null || echo rear)}
		case "$MODE" in rear|rear_full|front) ;; *) MODE=rear ;; esac
		CUR=$(cat /etc/zflip3-cam.mode 2>/dev/null || echo "")
		# stream.py fixes the mode at import, so a mode change needs a restart
		if [ -n "$(pid)" ] && [ "$CUR" = "$MODE" ]; then
			printf 'started mode=%s (already running)\n' "$MODE"
			exit 0
		fi
		for p in $(pid); do kill "$p" 2>/dev/null || true; done
		[ -n "$(pid)" ] && sleep 1
		"$SETUP" "$MODE" >/dev/null
		python3 "$STREAM" >"$LOG" 2>&1 &
		sleep 2
		printf 'started mode=%s\n' "$MODE" ;;
	stop)
		for p in $(ps 2>/dev/null | awk '/[s]tream.py/{print $1}'); do kill "$p" 2>/dev/null || true; done
		printf 'stopped\n' ;;
	audio-on)
		/usr/bin/setup-audio.sh
		printf 'audio on\n' ;;
	audio-off)
		amixer -c 0 sset 'Speaker Amp Gain ZC' off >/dev/null
		printf 'audio off\n' ;;
	*)
		echo "unknown: ${1:-}" >&2; exit 1 ;;
esac
